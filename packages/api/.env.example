DATABASE_URL=postgres://postgres:postgres@localhost:5432/railway_sessions
# One of the two: a project token (created in the Railway project settings) or an account API token
RAILWAY_PROJECT_TOKEN=
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=your_project_id
RAILWAY_ENVIRONMENT_ID=your_environment_id
RAILWAY_SERVICE_IMAGE=ghcr.io/rybosyme/dbt-sandbox:latest
ADMIN_PASSWORD=change-me
AUTH_TOKEN_SECRET=replace-with-secure-secret
WEB_ORIGIN=http://localhost:5173
PORT=3000
API_DIRECT_HOST=api.localhost
API_PROXY_HOST=proxy.localhost
SANDBOX_INTERNAL_DOMAIN=api.railway.internal
SANDBOX_PORT=8080
SANDBOX_REPO_URL=https://github.com/Rybosyme/dbt-sandbox-railway.git
GH_TOKEN=
# Anything prefixed SANDBOX_VAR_ is injected into every sandbox with the prefix stripped
SANDBOX_VAR_PGHOST=
SANDBOX_VAR_PGPORT=5432
SANDBOX_VAR_PGUSER=dbt_sandbox
SANDBOX_VAR_PGPASSWORD=
SANDBOX_VAR_PGDATABASE=railway
SANDBOX_VAR_PGSSLMODE=require
SANDBOX_VAR_ANTHROPIC_API_KEY=
SANDBOX_LOCAL_BASE_URL=http://localhost:8081
SANDBOX_LOCAL_MAP=sandbox-a=http://localhost:8081,sandbox-b=http://localhost:8082
LOCAL_MODE=true
